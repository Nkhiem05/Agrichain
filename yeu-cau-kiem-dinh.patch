+              </button>
+
+              <button
+                type="button"
+                className="btn-save"
+                onClick={handleSubmitInspection}
+                disabled={savingInspection}
+              >
+                {savingInspection ? "Đang gửi..." : "Gửi yêu cầu"}
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
